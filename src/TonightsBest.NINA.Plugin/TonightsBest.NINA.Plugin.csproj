<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>TonightsBest.NINA.Plugin</AssemblyName>
    <RootNamespace>TonightsBest.NINA.Plugin</RootNamespace>
    <!-- These two legacy native/UI dependencies are transitively required by the official NINA.Plugin package. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TonightsBest.Core/TonightsBest.Core.csproj" />
  </ItemGroup>
</Project>
