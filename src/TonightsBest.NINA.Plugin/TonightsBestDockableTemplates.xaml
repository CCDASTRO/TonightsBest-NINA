<ResourceDictionary x:Class="TonightsBest.NINA.Plugin.TonightsBestDockableTemplates"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="TonightsBest.NINA.Plugin.TonightsBestDockableVM_Dockable">
    <Grid Margin="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock FontWeight="SemiBold" Text="Tonight's Best — Top 15" FontSize="15"/>
      <StackPanel Grid.Row="1" Margin="0,8,0,8">
        <TextBlock Text="{Binding EquipmentSummary}" TextWrapping="Wrap" Opacity="0.8"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock VerticalAlignment="Center" Text="Minimum altitude:"/>
          <TextBox Width="45" Margin="6,0" Text="{Binding MinimumAltitude, UpdateSourceTrigger=PropertyChanged}" ToolTip="Targets receive visible time only while at or above this altitude."/>
          <TextBlock VerticalAlignment="Center" Text="°"/>
          <Button Margin="12,0,0,0" Padding="10,4" Content="Refresh Top 15" Command="{Binding RefreshCommand}"/>
        </StackPanel>
      </StackPanel>
      <DataGrid Grid.Row="2" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" AutoGenerateColumns="False"
                IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column" ToolTip="Select a target, then open it in Framing Assistant.">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Target" Binding="{Binding Target.Name}" Width="90"/>
          <DataGridTextColumn Header="Type" Binding="{Binding Target.ObjectType}" Width="90"/>
          <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="48"/>
          <DataGridTextColumn Header="Frame %" Binding="{Binding FrameCoveragePercent}" Width="58"/>
          <DataGridTextColumn Header="Hours" Binding="{Binding HoursAboveMinimumAltitude}" Width="48"/>
          <DataGridTextColumn Header="Max Alt" Binding="{Binding MaximumAltitudeDegrees}" Width="52"/>
          <DataGridTextColumn Header="Moon Sep" Binding="{Binding MoonSeparationDegrees}" Width="62"/>
          <DataGridTextColumn Header="Mag" Binding="{Binding Target.Magnitude}" Width="42"/>
        </DataGrid.Columns>
      </DataGrid>
      <Grid Grid.Row="3" Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,8,0"/>
        <Button Grid.Column="1" Padding="10,5" Content="Open in Framing Assistant" Command="{Binding OpenInFramingAssistantCommand}"/>
      </Grid>
    </Grid>
  </DataTemplate>
  <GeometryGroup x:Key="TonightsBestIcon">
    <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9"/>
    <PathGeometry Figures="M12,1 L14,8 L21,10 L14,12 L12,19 L10,12 L3,10 L10,8 Z"/>
  </GeometryGroup>
</ResourceDictionary>
