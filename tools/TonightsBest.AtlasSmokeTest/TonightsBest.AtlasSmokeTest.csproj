<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TonightsBest.AtlasSmokeTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/TonightsBest.NINA.Plugin/TonightsBest.NINA.Plugin.csproj" /></ItemGroup>
  <PropertyGroup>
    <NinaInstallDirectory>$(ProgramFiles)\N.I.N.A. - Nighttime Imaging 'N' Astronomy</NinaInstallDirectory>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(NinaInstallDirectory)\Database\Migration')">
    <Content Include="$(NinaInstallDirectory)\Database\Migration\**\*">
      <Link>Database\Migration\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
